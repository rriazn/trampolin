<%- include('partials/header', { title: t('leaderboard:pageTitle', { roundName: round.name }), autoRefresh: true }) %>

<div class="lb-hero">
  <div class="container">
    <p class="text-white-50 small mb-1"><i class="bi bi-trophy me-1"></i><%= round.competition_name %></p>
    <h1 class="fw-900 mb-1" style="font-size:2.2rem"><%= round.name %> &nbsp;·&nbsp; <%= round.group_name %></h1>
    <p class="text-white-50 small mb-0">
      <i class="bi bi-arrow-repeat me-1"></i><%= t('leaderboard:live') %>
      &nbsp;·&nbsp; <%= new Date().toLocaleTimeString() %>
    </p>
  </div>
</div>

<div class="container" style="padding-bottom:3rem">
<% if (!panelConfigured) { %>
<div class="card p-5 text-center text-muted mt-4">
  <i class="bi bi-exclamation-circle fs-1 mb-3 d-block" style="color:#b0b8d4"></i>
  <h5><%= t('leaderboard:panelNotConfiguredTitle') %></h5>
  <p class="mb-0 small"><%= t('leaderboard:panelNotConfiguredBody') %></p>
</div>
<% } else if (leaderboard.length === 0) { %>
<div class="card p-5 text-center text-muted mt-4">
  <i class="bi bi-hourglass-split fs-1 mb-3 d-block" style="color:#b0b8d4"></i>
  <h5><%= t('leaderboard:noAthletesScored') %></h5>
</div>
<% } else { %>
<div class="lb-table-wrap mt-0">
  <table class="table table-hover mb-0" style="background:#fff">
    <caption class="text-muted small px-2" style="caption-side:bottom">
      <sup>*</sup> <%= t('leaderboard:footnote') %>
    </caption>
    <thead>
      <tr>
        <th style="width:70px;background:var(--brand)" class="text-white text-center"><%= t('leaderboard:table.rank') %></th>
        <th style="background:var(--brand)" class="text-white"><%= t('leaderboard:table.athlete') %></th>
        <th style="background:var(--brand)" class="text-white"><%= t('leaderboard:table.club') %></th>
        <th style="background:var(--brand)" class="text-white"><%= t('leaderboard:table.group') %></th>
        <% for (let n = 1; n <= maxAttempts; n++) { %>
        <th style="background:var(--brand)" class="text-white text-center"><%= t('leaderboard:table.attempt', { number: n }) %></th>
        <% } %>
        <th style="background:var(--brand);width:130px" class="text-white text-end"><%= round.scoring_mode === 'sum' ? t('leaderboard:table.totalScore') : t('leaderboard:table.bestScore') %></th>
      </tr>
    </thead>
    <tbody>
    <% leaderboard.forEach((row, idx) => {
         const rankClass = row.rank === 1 ? 'gold' : row.rank === 2 ? 'silver' : row.rank === 3 ? 'bronze' : '';
         const rowBg = row.rank === 1 ? 'style="background:#fffbea"' : row.rank === 2 ? 'style="background:#f8f9fa"' : row.rank === 3 ? 'style="background:#fff8f3"' : '';
    %>
    <tr <%- rowBg %>>
      <td class="text-center align-middle">
        <% if (row.rank === 1) { %>
          <span class="lb-rank gold"><i class="bi bi-trophy-fill"></i></span>
        <% } else if (row.rank === 2) { %>
          <span class="lb-rank silver"><i class="bi bi-trophy-fill"></i></span>
        <% } else if (row.rank === 3) { %>
          <span class="lb-rank bronze"><i class="bi bi-trophy-fill"></i></span>
        <% } else { %>
          <span class="text-muted fw-700"><%= row.rank %></span>
        <% } %>
      </td>
      <td class="align-middle">
        <span class="fw-700 <%= row.rank === 1 ? 'fs-6' : '' %>"><%= row.name %></span>
      </td>
      <td class="align-middle text-muted"><%= row.club || '–' %></td>
      <td class="align-middle">
        <% if (row.group) { %>
        <span class="badge bg-light text-dark border"><%= row.group %></span>
        <% } else { %><span class="text-muted">–</span><% } %>
      </td>
      <% for (let n = 1; n <= maxAttempts; n++) {
           const a = row.attempts.find(a => a.number === n);
      %>
      <td class="text-center align-middle">
        <% if (a && a.finalScore !== null) {
             const breakdownTitle = a.breakdown.map(b => `${t('common:judgeRoles.' + b.judgeRoleKey)}: ${b.value.toFixed(2)}`).join(' · ');
        %>
          <span class="fw-600" title="<%= breakdownTitle %><%= a.isComplete ? '' : ' (partial)' %>">
            <%= a.finalScore.toFixed(3) %><% if (!a.isComplete) { %><sup class="text-muted">*</sup><% } %>
          </span>
          <% if (a.perTrickDetail.length > 0) { %>
          <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-bs-toggle="modal" data-bs-target="#pt-<%= row.sportsmanId %>-<%= a.number %>" title="Per-trick detail">
            <i class="bi bi-table"></i>
          </button>
          <% } %>
        <% } else { %><span class="text-muted">–</span><% } %>
      </td>
      <% } %>
      <td class="text-end align-middle">
        <% if (row.total !== null) { %>
          <span class="lb-score <%= rankClass %>"><%= row.total.toFixed(3) %></span>
        <% } else { %><span class="text-muted">–</span><% } %>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<% leaderboard.forEach(row => { %>
<% row.attempts.forEach(a => { %>
<% if (a.perTrickDetail.length > 0) { %>
<div class="modal fade" id="pt-<%= row.sportsmanId %>-<%= a.number %>" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= t('leaderboard:modal.attemptTitle', { name: row.name, number: a.number }) %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <% a.perTrickDetail.forEach(detail => { %>
        <h6 class="fw-700"><%= t('common:judgeRoles.' + detail.roleKey) %></h6>
        <div class="table-responsive mb-3">
          <table class="table table-sm table-bordered">
            <thead>
              <tr>
                <th><%= t('leaderboard:modal.judge') %></th>
                <% detail.elementNumbers.forEach(n => { %>
                <th class="text-center"><%= n === 11 ? (detail.isDeduction ? t('leaderboard:modal.landing') : t('leaderboard:modal.bonus')) : n %></th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
              <% detail.judges.forEach(j => { %>
              <tr>
                <td class="fw-600"><%= j.name %></td>
                <% j.values.forEach(v => { %>
                <td class="text-center"><%= v !== null ? v : '–' %></td>
                <% }) %>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>
<% } %>
<% }) %>
<% }) %>
<% } %>
</div>
<%- include('partials/footer') %>
