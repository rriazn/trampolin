<%- include('../partials/header', { title: t('referee:dashboard.pageTitle'), activePage: 'scoring' }) %>
<div class="page-hero">
  <div class="container">
    <h1><%= t('referee:dashboard.heading') %></h1>
    <p><%= t('referee:dashboard.subtitle') %></p>
  </div>
</div>

<div class="container">
<% if (rounds.length === 0) { %>
<div class="card p-5 text-center text-muted">
  <h2 class="h5"><%= t('referee:dashboard.noRoundsTitle') %></h2>
  <p class="mb-0 small"><%= t('referee:dashboard.noRoundsBody') %></p>
</div>
<% } else { %>
<div class="row g-3">
  <% rounds.forEach(r => { %>
  <div class="col-md-6 col-lg-4">
    <a href="/referee/competitions/<%= r.competition_id %>/groups/<%= r.group_id %>/rounds/<%= r.id %>" class="text-decoration-none card-link">
      <div class="card p-4 h-100">
        <div class="d-flex align-items-center gap-3">
          <div>
            <div class="fw-bold"><%= r.group_name %> · <%= r.name %></div>
            <div class="text-muted small"><%= r.competition_name %></div>
          </div>
        </div>
      </div>
    </a>
  </div>
  <% }) %>
</div>
<% } %>
</div>
<%- include('../partials/footer') %>
