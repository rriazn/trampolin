<%- include('../partials/header', { title: round.name, activePage: 'scoring' }) %>
<div class="page-hero">
  <div class="container d-flex justify-content-between align-items-end">
    <div>
      <h1><i class="bi bi-pencil-square me-2"></i><%= round.name %></h1>
      <p><%= round.competition_name %> &nbsp;·&nbsp; <%= round.group_name %></p>
    </div>
    <a href="/referee" class="btn btn-outline-light rounded-pill"><i class="bi bi-arrow-left me-1"></i>Back</a>
  </div>
</div>

<div class="container">
<% if (state === 'not_started') { %>
<div class="card p-5 text-center text-muted">
  <i class="bi bi-hourglass-split fs-1 mb-3 d-block" style="color:#b0b8d4"></i>
  <h5>Round not started yet</h5>
  <p class="mb-0 small">The head judge hasn't started this round. Check back once scoring begins.</p>
</div>
<% } else if (state === 'no_assignment') { %>
<div class="card p-5 text-center text-muted">
  <i class="bi bi-exclamation-circle fs-1 mb-3 d-block" style="color:#b0b8d4"></i>
  <h5>No judge role assigned</h5>
  <p class="mb-0 small">You don't have a judge role assigned for this competition. Contact the admin.</p>
</div>
<% } else { %>
<div class="card p-4 mb-4">
  <div class="d-flex align-items-center gap-3">
    <span class="badge bg-secondary rounded-pill fs-6">#<%= attempt.start_order %></span>
    <div>
      <div class="fw-700 fs-5"><%= attempt.sportsman_name %></div>
      <div class="text-muted small">
        <%= attempt.club || '–' %><% if (attempt.routine) { %> &nbsp;·&nbsp; <%= attempt.routine %><% } %>
      </div>
    </div>
    <span class="badge rounded-pill bg-primary ms-auto">Attempt #<%= attempt.attempt_number %></span>
  </div>
</div>

<% inputs.forEach(input => { %>
<div class="card p-4 mb-4">
  <h5 class="fw-700 mb-3"><i class="bi bi-person-video3 me-2"></i><%= input.name %></h5>

  <% if (input.granularity === 'element') { %>
  <form method="POST" action="/referee/score/elements" class="d-flex flex-wrap gap-2 align-items-end">
    <input type="hidden" name="attemptId" value="<%= attempt.attempt_id %>">
    <input type="hidden" name="judgeRoleId" value="<%= input.judge_role_id %>">
    <% input.elements.forEach(el => { %>
    <div>
      <label class="form-label small text-muted mb-1">Trick <%= el.number %></label>
      <input type="number" name="element_<%= el.number %>"
             value="<%= el.value !== null ? el.value : '' %>"
             min="<%= input.score_min %>" <% if (input.score_max !== null) { %>max="<%= input.score_max %>"<% } %>
             step="0.1" class="form-control form-control-sm" style="width:80px" required>
    </div>
    <% }) %>
    <button class="btn btn-sm btn-brand rounded-pill"><i class="bi bi-check-lg"></i> Save</button>
  </form>
  <% } else { %>
  <form method="POST" action="/referee/score" class="d-flex gap-2 align-items-center">
    <input type="hidden" name="attemptId" value="<%= attempt.attempt_id %>">
    <input type="hidden" name="judgeRoleId" value="<%= input.judge_role_id %>">
    <input type="number" name="score"
           value="<%= input.score !== null ? input.score : '' %>"
           min="<%= input.score_min %>" <% if (input.score_max !== null) { %>max="<%= input.score_max %>"<% } %>
           step="0.1" class="form-control form-control-sm" style="width:100px"
           placeholder="<%= input.score_min %>–<%= input.score_max !== null ? input.score_max : '∞' %>" required>
    <button class="btn btn-sm btn-brand rounded-pill"><i class="bi bi-check-lg"></i> Save</button>
    <% if (input.score !== null) { %>
    <span class="text-success fw-600 small"><i class="bi bi-check-circle-fill"></i> Saved</span>
    <% } %>
  </form>
  <% } %>
</div>
<% }) %>
<% } %>
</div>
<%- include('../partials/footer') %>
