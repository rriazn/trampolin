<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' && language === 'de' ? 'de' : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Trampo·Score</title>
  <link rel="preload" href="/vendor/inter/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link href="<%= assetUrl('/vendor/bootstrap/css/bootstrap.min.css') %>" rel="stylesheet">
  <link href="<%= assetUrl('/vendor/bootstrap-icons/bootstrap-icons.min.css') %>" rel="stylesheet">
  <link href="<%= assetUrl('/style.css') %>" rel="stylesheet">
</head>
<body>
<a class="skip-link visually-hidden-focusable" href="#main"><%= t('common:nav.skipToContent') %></a>
<% if (typeof hideNav !== 'undefined' && hideNav) { %>
<%- include('lang-switcher') %>
<% } else { %>
<nav class="navbar navbar-main navbar-expand-lg" data-bs-theme="dark">
  <div class="container<%= typeof wide !== 'undefined' && wide ? ' lb-container' : '' %>">
    <a class="navbar-brand" href="/">Trampo<span class="dot">·</span>Score</a>
    <% if (currentUser) { %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="<%= t('common:nav.toggle') %>">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <div class="nav-items ms-lg-auto d-flex flex-column flex-lg-row align-items-lg-center gap-2 gap-lg-3 pt-3 pt-lg-0">
        <span class="nav-user-chip"><%= currentUser.name %></span>
        <% if (currentUser.role === 'admin') { %>
        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage==='admin' ? 'active' : '' %>" href="/admin"><%= t('common:nav.admin') %></a>
        <% } %>
        <% if (currentUser.role === 'referee') { %>
        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage==='scoring' ? 'active' : '' %>" href="/referee"><%= t('common:nav.scoring') %></a>
        <% } %>
        <% if (currentUser.role === 'head_judge') { %>
        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage==='head-judge' ? 'active' : '' %>" href="/head-judge"><%= t('common:nav.headJudge') %></a>
        <% } %>
        <% if (currentUser.role === 'viewer') { %>
        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage==='viewer' ? 'active' : '' %>" href="/viewer"><%= t('common:nav.viewer') %></a>
        <% } %>
        <%- include('lang-switcher', { modifier: 'lang-switcher-inline' }) %>
        <form method="POST" action="/logout" class="m-0">
          <button class="btn btn-outline-light btn-touch"><%= t('common:nav.logout') %></button>
        </form>
      </div>
    </div>
    <% } else { %>
    <%- include('lang-switcher', { modifier: 'lang-switcher-inline ms-auto' }) %>
    <% } %>
  </div>
</nav>
<% } %>

<main id="main">
<% if (typeof flash !== 'undefined' && flash.success) { %>
<div class="container mt-3">
  <div class="alert flash-bar alert-success d-flex align-items-center gap-2" role="alert">
    <i class="bi bi-check-circle-fill"></i> <%= flash.success %>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="<%= t('common:actions.close') %>"></button>
  </div>
</div>
<% } %>
<% if (typeof flash !== 'undefined' && flash.error) { %>
<div class="container mt-3">
  <div class="alert flash-bar alert-danger d-flex align-items-center gap-2" role="alert">
    <i class="bi bi-exclamation-triangle-fill"></i> <%= flash.error %>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="<%= t('common:actions.close') %>"></button>
  </div>
</div>
<% } %>
