</main>

<footer class="app-footer mt-5">
  <div class="container<%= typeof wide !== 'undefined' && wide ? ' lb-container' : '' %> d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
    <span class="app-footer-text">&copy; <%= new Date().getFullYear() %> Trampo<span class="dot">·</span>Score</span>
    <span class="app-footer-version"><%= typeof appVersion !== 'undefined' && appVersion !== 'latest' ? 'v' + appVersion : t('common:footer.versionLatest') %></span>
  </div>
</footer>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="h5 modal-title" id="confirmModalTitle"><%= t('common:confirmDialog.title') %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common:actions.close') %>"></button>
      </div>
      <div class="modal-body" id="confirmModalMessage"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-touch" data-bs-dismiss="modal"><%= t('common:actions.cancel') %></button>
        <button type="button" class="btn btn-accent btn-touch" id="confirmModalAccept"><%= t('common:actions.confirm') %></button>
      </div>
    </div>
  </div>
</div>

<script src="<%= assetUrl('/vendor/bootstrap/js/bootstrap.bundle.min.js') %>"></script>
<script src="<%= assetUrl('/table-scroll.js') %>" defer></script>
<script src="<%= assetUrl('/confirm-dialog.js') %>" defer></script>
</body>
</html>
