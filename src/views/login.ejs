<%- include('partials/header', { title: t('login:pageTitle'), hideNav: true }) %>
<div class="login-bg">
  <div class="login-card card p-4 p-md-5 mx-3">
    <div class="text-center mb-4">
      <div class="login-logo">Trampo<span>·</span>Score</div>
      <p class="text-muted mt-1 small"><%= t('login:subtitle') %></p>
    </div>
    <% if (error) { %>
    <div class="alert alert-danger d-flex align-items-center gap-2 py-2">
      <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
    </div>
    <% } %>
    <form method="POST" action="/login">
      <div class="mb-3">
        <label class="form-label fw-semibold small text-muted text-uppercase" for="f-email"><%= t('login:email') %></label>
        <input type="email" name="email" id="f-email" class="form-control" placeholder="<%= t('login:emailPlaceholder') %>" required autofocus>
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold small text-muted text-uppercase" for="f-password"><%= t('login:password') %></label>
        <input type="password" name="password" id="f-password" class="form-control" placeholder="<%= t('login:passwordPlaceholder') %>" required>
      </div>
      <button type="submit" class="btn btn-accent w-100 py-2">
        <%= t('login:signIn') %>
      </button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
