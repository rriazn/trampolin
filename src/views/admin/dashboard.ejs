<%- include('../partials/header', { title: t('admin:dashboard.pageTitle'), activePage: 'admin' }) %>

<div class="page-hero">
  <div class="container">
    <h1><i class="bi bi-speedometer2 me-2"></i><%= t('admin:dashboard.heading') %></h1>
    <p><%= t('admin:dashboard.subtitle') %></p>
  </div>
</div>

<div class="container">
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="stat-card stat-blue">
        <i class="bi bi-person-badge stat-icon"></i>
        <div class="stat-num"><%= stats.users %></div>
        <div class="stat-label"><%= t('admin:dashboard.referees') %></div>
        <a href="/admin/users" class="btn btn-sm btn-light mt-3 rounded-pill"><%= t('admin:dashboard.manage') %> <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
    <div class="col-md-6">
      <div class="stat-card stat-orange">
        <i class="bi bi-trophy stat-icon"></i>
        <div class="stat-num"><%= stats.competitions %></div>
        <div class="stat-label"><%= t('admin:dashboard.competitions') %></div>
        <a href="/admin/competitions" class="btn btn-sm btn-light mt-3 rounded-pill"><%= t('admin:dashboard.manage') %> <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="section-title mb-0"><i class="bi bi-calendar3 me-2"></i><%= t('admin:dashboard.recentCompetitions') %></h5>
    <a href="/admin/competitions/new" class="btn btn-brand btn-sm rounded-pill px-3"><i class="bi bi-plus-lg me-1"></i><%= t('admin:dashboard.new') %></a>
  </div>

  <% if (competitions.length === 0) { %>
  <div class="card p-4 text-center text-muted">
    <i class="bi bi-calendar-x fs-1 mb-2 d-block"></i>
    <%= t('admin:dashboard.noCompetitions') %> <a href="/admin/competitions/new"><%= t('admin:dashboard.createOne') %></a>.
  </div>
  <% } else { %>
  <div class="table-card card">
    <table class="table mb-0">
      <thead><tr><th><%= t('admin:dashboard.table.name') %></th><th><%= t('admin:dashboard.table.date') %></th><th><%= t('admin:dashboard.table.status') %></th><th></th></tr></thead>
      <tbody>
      <% competitions.forEach(c => { %>
        <tr>
          <td class="fw-600"><%= c.name %></td>
          <td><%= c.date || '–' %></td>
          <td><span class="badge rounded-pill status-<%= c.status %>"><%= t('common:status.' + c.status) %></span></td>
          <td class="text-end">
            <a href="/admin/competitions/<%= c.id %>/groups" class="btn btn-sm btn-brand rounded-pill">
              <i class="bi bi-collection me-1"></i><%= t('admin:dashboard.table.groups') %>
            </a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
