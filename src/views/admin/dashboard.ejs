<%- include('../partials/header', { title: t('admin:dashboard.pageTitle'), activePage: 'admin' }) %>

<div class="page-hero">
  <div class="container">
    <h1><%= t('admin:dashboard.heading') %></h1>
    <p><%= t('admin:dashboard.subtitle') %></p>
  </div>
</div>

<div class="container">
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="stat-card stat-referees">
        <div class="stat-num"><%= stats.users %></div>
        <div class="stat-label"><%= t('admin:dashboard.referees') %></div>
        <a href="/admin/users" class="btn btn-sm btn-outline-secondary mt-3"><%= t('admin:dashboard.manage') %></a>
      </div>
    </div>
    <div class="col-md-6">
      <div class="stat-card stat-competitions">
        <div class="stat-num"><%= stats.competitions %></div>
        <div class="stat-label"><%= t('admin:dashboard.competitions') %></div>
        <a href="/admin/competitions" class="btn btn-sm btn-outline-secondary mt-3"><%= t('admin:dashboard.manage') %></a>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="section-title mb-0"><%= t('admin:dashboard.recentCompetitions') %></h5>
    <a href="/admin/competitions/new" class="btn btn-accent"><%= t('admin:dashboard.new') %></a>
  </div>

  <% if (competitions.length === 0) { %>
  <div class="card p-4 text-center text-muted">
    <%= t('admin:dashboard.noCompetitions') %> <a href="/admin/competitions/new"><%= t('admin:dashboard.createOne') %></a>.
  </div>
  <% } else { %>
  <div class="table-card card">
    <table class="table mb-0">
      <thead><tr><th><%= t('admin:dashboard.table.name') %></th><th><%= t('admin:dashboard.table.date') %></th><th><%= t('admin:dashboard.table.status') %></th><th></th></tr></thead>
      <tbody>
      <% competitions.forEach(c => { %>
        <tr>
          <td class="fw-semibold"><%= c.name %></td>
          <td><%= c.date || '–' %></td>
          <td><span class="badge status-<%= c.status %>"><%= t('common:status.' + c.status) %></span></td>
          <td class="text-end">
            <a href="/admin/competitions/<%= c.id %>/groups" class="btn btn-sm btn-brand">
              <%= t('admin:dashboard.table.groups') %>
            </a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
