<%- include('../partials/header', { title: t('admin:competitions.heading'), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container d-flex justify-content-between align-items-center">
    <div>
      <h1><i class="bi bi-trophy me-2"></i><%= t('admin:competitions.heading') %></h1>
      <p><%= t('admin:competitions.subtitle') %></p>
    </div>
    <a href="/admin/competitions/new" class="btn btn-accent rounded-pill"><i class="bi bi-plus-lg me-1"></i><%= t('admin:competitions.newCompetition') %></a>
  </div>
</div>

<div class="container">
  <div class="table-card card">
    <table class="table mb-0">
      <thead>
        <tr>
          <th><%= t('admin:competitions.table.name') %></th>
          <th><%= t('admin:competitions.table.date') %></th>
          <th><%= t('admin:competitions.table.type') %></th>
          <th><%= t('admin:competitions.table.status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% competitions.forEach(c => { %>
      <tr>
        <td class="fw-600"><%= c.name %></td>
        <td class="text-muted"><%= c.date || '–' %></td>
        <td><span class="badge rounded-pill text-bg-light border px-3 competition-type-<%= c.type %>"><%= t('common:competitionTypes.' + c.type) %></span></td>
        <td><span class="badge rounded-pill status-<%= c.status %> px-3"><%= t('common:status.' + c.status) %></span></td>
        <td class="text-end">
          <a href="/admin/competitions/<%= c.id %>/groups" class="btn btn-sm btn-brand rounded-pill me-1">
            <i class="bi bi-collection me-1"></i><%= t('admin:competitions.groups') %>
          </a>
          <a href="/admin/competitions/<%= c.id %>/judges" class="btn btn-sm btn-brand rounded-pill me-1">
            <i class="bi bi-person-badge me-1"></i><%= t('admin:competitions.judges') %>
          </a>
          <a href="/admin/competitions/<%= c.id %>/edit" class="btn btn-sm btn-outline-secondary rounded-pill me-1">
            <i class="bi bi-pencil"></i>
          </a>
          <% if (c.status === 'planned') { %>
          <form method="POST" action="/admin/competitions/<%= c.id %>/status" class="d-inline">
            <input type="hidden" name="status" value="active">
            <button class="btn btn-sm btn-success rounded-pill me-1"><i class="bi bi-play-fill me-1"></i><%= t('admin:competitions.activate') %></button>
          </form>
          <% } else if (c.status === 'active') { %>
          <form method="POST" action="/admin/competitions/<%= c.id %>/status" class="d-inline">
            <input type="hidden" name="status" value="closed">
            <button class="btn btn-sm btn-outline-secondary rounded-pill me-1"><i class="bi bi-stop-fill me-1"></i><%= t('admin:competitions.close') %></button>
          </form>
          <% } else if (c.status === 'closed') { %>
          <details class="d-inline-block align-middle text-start me-1 results-pdf">
            <summary class="btn btn-sm btn-brand rounded-pill"><i class="bi bi-file-earmark-pdf me-1"></i><%= t('results:ui.summary') %></summary>
            <form method="POST" action="/admin/competitions/<%= c.id %>/results" enctype="multipart/form-data" class="results-form border rounded bg-white p-3 mt-2">
              <label class="form-label small" for="results-template-<%= c.id %>"><%= t('results:ui.templateLabel') %></label>
              <input type="file" id="results-template-<%= c.id %>" name="template" accept=".typ" class="form-control form-control-sm mb-2">
              <button type="submit" class="btn btn-sm btn-brand rounded-pill me-1"><i class="bi bi-download me-1"></i><%= t('results:ui.download') %></button>
              <button type="submit" formaction="/admin/results/preview" formtarget="_blank" class="btn btn-sm btn-outline-secondary rounded-pill" disabled><i class="bi bi-eye me-1"></i><%= t('results:ui.preview') %></button>
              <div class="small mt-2">
                <a href="/admin/results/default-template"><%= t('results:ui.defaultTemplate') %></a>
                <span class="text-muted mx-1">&middot;</span>
                <a href="/admin/results/sample-data"><%= t('results:ui.sampleData') %></a>
              </div>
            </form>
          </details>
          <% } %>
          <form method="POST" action="/admin/competitions/<%= c.id %>/delete" class="d-inline"
                onsubmit="return confirm(<%= JSON.stringify(t('admin:competitions.confirmDelete')) %>)">
            <button class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<script>
  // the preview only runs when a template file is chosen
  document.querySelectorAll('.results-form').forEach((form) => {
    const file = form.querySelector('input[type=file]');
    const preview = form.querySelector('button[formaction]');
    file.addEventListener('change', () => { preview.disabled = file.files.length === 0; });
  });
</script>
<%- include('../partials/footer') %>
