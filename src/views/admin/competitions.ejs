<%- include('../partials/header', { title: t('admin:competitions.heading'), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div>
      <h1><%= t('admin:competitions.heading') %></h1>
      <p><%= t('admin:competitions.subtitle') %></p>
    </div>
    <a href="/admin/competitions/new" class="btn btn-accent"><%= t('admin:competitions.newCompetition') %></a>
  </div>
</div>

<div class="container">
  <div class="table-card card">
    <table class="table mb-0">
      <thead>
        <tr>
          <th scope="col"><%= t('admin:competitions.table.name') %></th>
          <th scope="col"><%= t('admin:competitions.table.date') %></th>
          <th scope="col"><%= t('admin:competitions.table.type') %></th>
          <th scope="col"><%= t('admin:competitions.table.status') %></th>
          <th scope="col"><span class="visually-hidden"><%= t('common:actions.column') %></span></th>
        </tr>
      </thead>
      <tbody>
      <% competitions.forEach(c => { %>
      <tr>
        <td class="fw-semibold"><%= c.name %></td>
        <td class="text-muted"><%= c.date || '–' %></td>
        <td><span class="badge text-bg-light border px-3 competition-type-<%= c.type %>"><%= t('common:competitionTypes.' + c.type) %></span></td>
        <td><span class="badge status-<%= c.status %> px-3"><%= t('common:status.' + c.status) %></span></td>
        <td class="text-end">
          <div class="competition-actions">
            <div class="competition-actions-grid">
              <a href="/admin/competitions/<%= c.id %>/groups" class="btn btn-sm btn-brand">
                <%= t('admin:competitions.groups') %>
              </a>
              <a href="/admin/competitions/<%= c.id %>/starting-groups" class="btn btn-sm btn-brand">
                <%= t('admin:competitions.startingGroups') %>
              </a>
              <a href="/admin/competitions/<%= c.id %>/judges" class="btn btn-sm btn-brand">
                <%= t('admin:competitions.judges') %>
              </a>
              <a href="/admin/competitions/<%= c.id %>/documents" class="btn btn-sm btn-brand">
                <%= t('admin:competitions.documents') %>
              </a>
              <% if (c.status === 'planned') { %>
              <form method="POST" action="/admin/competitions/<%= c.id %>/status">
                <input type="hidden" name="status" value="active">
                <button class="btn btn-sm btn-outline-secondary w-100"><%= t('admin:competitions.activate') %></button>
              </form>
              <% } else if (c.status === 'active') { %>
              <form method="POST" action="/admin/competitions/<%= c.id %>/status">
                <input type="hidden" name="status" value="closed">
                <button class="btn btn-sm btn-outline-secondary w-100"><%= t('admin:competitions.close') %></button>
              </form>
              <% } %>
            </div>
            <div class="competition-actions-icons">
              <a href="/admin/competitions/<%= c.id %>/edit" class="btn btn-sm btn-outline-secondary" aria-label="<%= t('common:actions.edit') %>" title="<%= t('common:actions.edit') %>">
                <i class="bi bi-pencil"></i>
              </a>
              <form method="POST" action="/admin/competitions/<%= c.id %>/delete"
                    data-confirm="<%= t('admin:competitions.confirmDelete') %>">
                <button class="btn btn-sm btn-outline-danger w-100" aria-label="<%= t('common:actions.delete') %>" title="<%= t('common:actions.delete') %>"><i class="bi bi-trash"></i></button>
              </form>
            </div>
          </div>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
