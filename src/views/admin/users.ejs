<%- include('../partials/header', { title: t('admin:users.pageTitle'), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div>
      <h1><%= t('admin:users.heading') %></h1>
      <p><%= t('admin:users.subtitle') %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#uploadForm">
        <%= t('admin:users.importExcel') %>
      </button>
      <a href="/admin/users/export" class="btn btn-outline-secondary">
        <%= t('admin:users.exportExcel') %>
      </a>
      <a href="/admin/users/new" class="btn btn-accent"><%= t('admin:users.addUser') %></a>
    </div>
  </div>
</div>

<div class="container">
  <div class="collapse mb-4" id="uploadForm">
    <div class="upload-panel">
      <h6 class="fw-bold mb-1"><%= t('admin:users.importHeading') %></h6>
      <p class="text-muted small mb-3"><%- t('admin:users.importHelp') %></p>
      <form method="POST" action="/admin/users/upload" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap">
        <input type="file" name="file" class="form-control" accept=".xlsx,.xls,.ods,.csv" required style="max-width:320px">
        <button type="submit" class="btn btn-brand"><%= t('admin:users.upload') %></button>
      </form>
    </div>
  </div>

  <div class="table-card card">
    <table class="table mb-0">
      <thead>
        <tr><th><%= t('admin:users.table.name') %></th><th><%= t('admin:users.table.email') %></th><th><%= t('admin:users.table.role') %></th><th><%= t('admin:users.table.created') %></th><th></th></tr>
      </thead>
      <tbody>
      <% users.forEach(u => { %>
      <tr>
        <td class="fw-semibold"><%= u.name %></td>
        <td class="text-muted"><%= u.email %></td>
        <td><span class="badge text-bg-light border"><%= t('common:roles.' + u.role) %></span></td>
        <td class="text-muted small"><%= u.created_at.substring(0,10) %></td>
        <td class="text-end">
          <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-secondary me-1" aria-label="<%= t('common:actions.edit') %>" title="<%= t('common:actions.edit') %>">
            <i class="bi bi-pencil"></i>
          </a>
          <form method="POST" action="/admin/users/<%= u.id %>/delete" class="d-inline"
                onsubmit="return confirm(<%= JSON.stringify(t('admin:users.confirmDelete', { name: u.name })) %>)">
            <button class="btn btn-sm btn-outline-danger" aria-label="<%= t('common:actions.delete') %>" title="<%= t('common:actions.delete') %>"><i class="bi bi-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
