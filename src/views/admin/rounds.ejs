<%- include('../partials/header', { title: t('admin:rounds.pageTitle', { name: group.name }), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2" style="--bs-breadcrumb-divider-color:rgba(255,255,255,.5); --bs-breadcrumb-item-active-color:#fff">
        <li class="breadcrumb-item"><a href="/admin/competitions" class="text-white-50"><%= t('admin:competitionForm.breadcrumbCompetitions') %></a></li>
        <li class="breadcrumb-item"><a href="/admin/competitions/<%= competition.id %>/groups" class="text-white-50"><%= competition.name %></a></li>
        <li class="breadcrumb-item active text-white"><%= group.name %></li>
      </ol>
    </nav>
    <h1><i class="bi bi-list-ol me-2"></i><%= t('admin:rounds.heading') %></h1>
    <p><%= group.name %> &nbsp;·&nbsp; <%= competition.name %></p>
  </div>
</div>

<div class="container">
  <% if (rounds.length === 0) { %>
  <div class="card p-4 text-center text-muted mb-4">
    <i class="bi bi-list-ol fs-1 mb-2 d-block"></i><%= t('admin:rounds.noRounds') %>
  </div>
  <% } else { %>
  <div class="table-card card mb-4">
    <table class="table mb-0">
      <thead><tr><th style="width:80px"><%= t('admin:rounds.table.order') %></th><th><%= t('admin:rounds.table.roundName') %></th><th><%= t('admin:rounds.table.scoringMode') %></th><th></th></tr></thead>
      <tbody>
      <% rounds.forEach(r => { %>
      <tr>
        <td><span class="badge bg-secondary rounded-pill"><%= r.round_order %></span></td>
        <td class="fw-600"><i class="bi bi-flag me-2 text-muted"></i><%= r.name %></td>
        <td class="fw-700">
          <%= t('common:scoringMode.' + r.scoring_mode) %>
        </td>
        <td class="text-end">
          <a href="/admin/competitions/<%= competition.id %>/groups/<%= group.id %>/rounds/<%= r.id %>/entries" class="btn btn-sm btn-brand rounded-pill me-1">
            <i class="bi bi-people me-1"></i><%= t('admin:rounds.entries') %>
          </a>
          <a href="/leaderboard/competitions/<%= competition.id %>/groups/<%= group.id %>/rounds/<%= r.id %>" target="_blank" class="btn btn-sm btn-outline-info rounded-pill me-1">
            <i class="bi bi-bar-chart me-1"></i><%= t('admin:rounds.leaderboard') %>
          </a>
          <form method="POST" action="/admin/competitions/<%= competition.id %>/groups/<%= group.id %>/rounds/<%= r.id %>/delete" class="d-inline"
                onsubmit="return confirm(<%= JSON.stringify(t('admin:rounds.confirmDelete')) %>)">
            <button class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <div class="card p-4">
    <h5 class="fw-700 mb-3"><i class="bi bi-plus-circle me-2"></i><%= t('admin:rounds.addRound') %></h5>
    <% if (locals.error) { %>
    <div class="alert alert-danger mb-3"><%= locals.error %></div>
    <% } %>
    <form method="POST" action="/admin/competitions/<%= competition.id %>/groups/<%= group.id %>/rounds" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:rounds.name') %></label>
        <input type="text" name="name" class="form-control" placeholder="<%= t('admin:rounds.namePlaceholder') %>" required>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:rounds.order') %></label>
        <input type="number" name="round_order" class="form-control" value="<%= rounds.length + 1 %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:rounds.scoringMode') %></label>
        <select name="scoring_mode" class="form-select" required>
          <option value="sum"><%= t('common:scoringMode.sum') %></option>
          <option value="best_attempt"><%= t('common:scoringMode.best_attempt') %></option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-brand rounded-pill w-100"><i class="bi bi-plus-lg me-1"></i><%= t('common:actions.add') %></button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
