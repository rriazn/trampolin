<%- include('../partials/header', { title: t('admin:rounds.pageTitle', { name: group.name }), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/admin/competitions"><%= t('admin:competitionForm.breadcrumbCompetitions') %></a></li>
        <li class="breadcrumb-item"><a href="/admin/competitions/<%= competition.id %>/groups"><%= competition.name %></a></li>
        <li class="breadcrumb-item active"><%= group.name %></li>
      </ol>
    </nav>
    <h1><%= t('admin:rounds.heading') %></h1>
    <p><%= group.name %> &nbsp;·&nbsp; <%= competition.name %></p>
  </div>
</div>

<div class="container">
  <% if (rounds.length === 0) { %>
  <div class="card p-4 text-center text-muted mb-4">
    <%= t('admin:rounds.noRounds') %>
  </div>
  <% } else { %>
  <div class="table-card card mb-4">
    <table class="table mb-0">
      <thead><tr><th scope="col" class="col-narrow"><%= t('admin:rounds.table.order') %></th><th scope="col"><%= t('admin:rounds.table.roundName') %></th><th scope="col"><%= t('admin:rounds.table.scoringMode') %></th><th scope="col"><span class="visually-hidden"><%= t('common:actions.column') %></span></th></tr></thead>
      <tbody>
      <% rounds.forEach(r => { %>
      <tr>
        <td><span class="badge bg-secondary"><%= r.round_order %></span></td>
        <td class="fw-semibold"><%= r.name %></td>
        <td class="fw-bold">
          <%= t('common:scoringMode.' + r.scoring_mode) %>
        </td>
        <td class="text-end">
          <a href="/admin/competitions/<%= competition.id %>/groups/<%= group.id %>/rounds/<%= r.id %>/entries" class="btn btn-sm btn-brand me-1">
            <%= t('admin:rounds.entries') %>
          </a>
          <a href="/leaderboard/competitions/<%= competition.id %>/groups/<%= group.id %>/rounds/<%= r.id %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-1">
            <%= t('admin:rounds.leaderboard') %><span class="visually-hidden"> (<%= t('common:actions.opensInNewTab') %>)</span>
          </a>
          <form method="POST" action="/admin/competitions/<%= competition.id %>/groups/<%= group.id %>/rounds/<%= r.id %>/delete" class="d-inline"
                data-confirm="<%= t('admin:rounds.confirmDelete') %>">
            <button class="btn btn-sm btn-outline-danger" aria-label="<%= t('common:actions.delete') %>" title="<%= t('common:actions.delete') %>"><i class="bi bi-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <div class="card p-4">
    <h2 class="h5 fw-bold mb-3"><%= t('admin:rounds.addRound') %></h2>
    <% if (locals.error) { %>
    <div class="alert alert-danger mb-3"><%= locals.error %></div>
    <% } %>
    <form method="POST" action="/admin/competitions/<%= competition.id %>/groups/<%= group.id %>/rounds" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label small fw-semibold text-muted text-uppercase" for="f-name"><%= t('admin:rounds.name') %></label>
        <input type="text" name="name" id="f-name" class="form-control" placeholder="<%= t('admin:rounds.namePlaceholder') %>" required>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-muted text-uppercase" for="f-round_order"><%= t('admin:rounds.order') %></label>
        <input type="number" name="round_order" id="f-round_order" class="form-control" value="<%= rounds.length + 1 %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-muted text-uppercase" for="f-scoring_mode"><%= t('admin:rounds.scoringMode') %></label>
        <select name="scoring_mode" id="f-scoring_mode" class="form-select" required>
          <option value="sum"><%= t('common:scoringMode.sum') %></option>
          <option value="best_attempt"><%= t('common:scoringMode.best_attempt') %></option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-accent w-100"><%= t('common:actions.add') %></button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
