<%- include('../partials/header', { title: sportsman ? t('admin:sportsmanForm.editTitle') : t('admin:sportsmanForm.newTitle'), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/admin/competitions"><%= t('admin:competitionForm.breadcrumbCompetitions') %></a></li>
        <li class="breadcrumb-item"><a href="/admin/competitions/<%= competition.id %>/groups"><%= competition.name %></a></li>
        <li class="breadcrumb-item"><a href="/admin/competitions/<%= competition.id %>/sportsmen"><%= t('admin:sportsmanForm.breadcrumbAthletes') %></a></li>
        <li class="breadcrumb-item active"><%= sportsman ? t('common:actions.edit') : t('admin:sportsmanForm.newTitle') %></li>
      </ol>
    </nav>
    <h1><i class="bi bi-person-<%= sportsman ? 'gear' : 'plus' %> me-2"></i><%= sportsman ? t('admin:sportsmanForm.editTitle') : t('admin:sportsmanForm.newTitle') %></h1>
  </div>
</div>
<div class="container">
<div class="row justify-content-center">
<div class="col-md-6">
<div class="card p-4">
<% if (locals.error) { %>
<div class="alert alert-danger"><%= locals.error %></div>
<% } %>
<%
  // athlete 1 uses the plain column names, athlete 2 of a synchro pair uses the partner_ prefix
  var isSynchro = competition.type === 'synchro';
  var athletes = [{ prefix: '', title: 'admin:sportsmanForm.athlete1', nameRequired: true }];
  if (isSynchro) athletes.push({ prefix: 'partner_', title: 'admin:sportsmanForm.athlete2', nameRequired: true });
%>
<form method="POST" action="<%= action %>">
  <% athletes.forEach(a => {
    var v = function (col) { return sportsman ? (sportsman[a.prefix + col] || '') : ''; };
  %>
  <div class="athlete-block" data-athlete="<%= a.prefix ? 'partner' : 'main' %>">
    <% if (isSynchro) { %><h6 class="fw-700 mb-3"><%= t(a.title) %></h6><% } %>
    <div class="mb-3">
      <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:sportsmanForm.fullName') %></label>
      <input type="text" name="<%= a.prefix %>name" class="form-control" value="<%= v('name') %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:sportsmanForm.club') %> <span class="text-muted fw-normal"><%= t('admin:competitionForm.optional') %></span></label>
      <input type="text" name="<%= a.prefix %>club" class="form-control" value="<%= v('club') %>">
    </div>
    <div class="row mb-3">
      <div class="col-md-6">
        <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:sportsmanForm.gender') %></label>
        <select name="<%= a.prefix %>gender" class="form-select">
          <option value=""><%= t('admin:sportsmanForm.genderNotSet') %></option>
          <option value="m" <%= v('gender') === 'm' ? 'selected' : '' %>><%= t('admin:sportsmanForm.genderMale') %></option>
          <option value="f" <%= v('gender') === 'f' ? 'selected' : '' %>><%= t('admin:sportsmanForm.genderFemale') %></option>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:sportsmanForm.birthYear') %></label>
        <input type="number" name="<%= a.prefix %>birth_year" class="form-control" value="<%= v('birth_year') %>" placeholder="<%= t('admin:sportsmanForm.birthYearPlaceholder') %>" min="1900" max="2099">
      </div>
    </div>
  </div>
  <% }) %>
  <div class="mb-3">
    <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:sportsmanForm.routine') %> <span class="text-muted fw-normal"><%= t('admin:competitionForm.optional') %></span></label>
    <input type="text" name="routine" class="form-control" value="<%= sportsman ? (sportsman.routine || '') : '' %>" placeholder="<%= t('admin:sportsmanForm.routinePlaceholder') %>">
  </div>
  <% if (groups && groups.length > 0) { %>
  <div class="mb-4">
    <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:sportsmanForm.group') %> <span class="text-muted fw-normal"><%= t('admin:competitionForm.optional') %></span></label>
    <select name="group_id" class="form-select">
      <option value=""><%= t('admin:sportsmanForm.groupUnassigned') %></option>
      <% groups.forEach(g => { %>
      <option value="<%= g.id %>" <%= sportsman && sportsman.group_id === g.id ? 'selected' : '' %>><%= g.name %></option>
      <% }) %>
    </select>
  </div>
  <% } %>
  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-brand rounded-pill px-4"><i class="bi bi-check-lg me-1"></i><%= sportsman ? t('common:actions.save') : t('common:actions.create') %></button>
    <a href="/admin/competitions/<%= competition.id %>/sportsmen" class="btn btn-outline-secondary rounded-pill px-4"><%= t('common:actions.cancel') %></a>
  </div>
</form>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
