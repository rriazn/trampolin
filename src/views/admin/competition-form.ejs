<%- include('../partials/header', { title: competition ? t('admin:competitionForm.editTitle') : t('admin:competitionForm.newTitle'), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2" style="--bs-breadcrumb-divider-color:rgba(255,255,255,.5)">
        <li class="breadcrumb-item"><a href="/admin/competitions" class="text-white-50"><%= t('admin:competitionForm.breadcrumbCompetitions') %></a></li>
        <li class="breadcrumb-item active text-white"><%= competition ? t('common:actions.edit') : t('admin:competitionForm.newTitle') %></li>
      </ol>
    </nav>
    <h1><i class="bi bi-trophy me-2"></i><%= competition ? t('admin:competitionForm.editTitle') : t('admin:competitionForm.newTitle') %></h1>
  </div>
</div>
<div class="container">
<div class="row justify-content-center">
<div class="col-md-6">
<div class="card p-4">
<% if (locals.error) { %>
<div class="alert alert-danger"><%= locals.error %></div>
<% } %>
<form method="POST" action="<%= action %>">
  <div class="mb-3">
    <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:competitionForm.name') %></label>
    <input type="text" name="name" class="form-control" value="<%= competition ? competition.name : '' %>" required placeholder="<%= t('admin:competitionForm.namePlaceholder') %>">
  </div>
  <div class="mb-3">
    <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:competitionForm.date') %> <span class="text-muted fw-normal"><%= t('admin:competitionForm.optional') %></span></label>
    <input type="date" name="date" class="form-control" value="<%= competition ? (competition.date || '') : '' %>">
  </div>
  <div class="mb-4">
    <label class="form-label small fw-600 text-muted text-uppercase"><%= t('admin:competitionForm.judgePanel') %> <span class="text-muted fw-normal"><%= t('admin:competitionForm.optional') %></span></label>
    <select name="panel_template_id" class="form-select">
      <option value=""><%= t('admin:competitionForm.noneSelected') %></option>
      <% panelTemplates.forEach(pt => { %>
      <option value="<%= pt.id %>" title="<%= pt.description %>" <%= (competition && competition.panel_template_id === pt.id) ? 'selected' : '' %>><%= pt.name %></option>
      <% }) %>
    </select>
    <div class="form-text"><%= t('admin:competitionForm.panelHelp') %></div>
  </div>
  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-brand rounded-pill px-4"><i class="bi bi-check-lg me-1"></i><%= competition ? t('common:actions.save') : t('common:actions.create') %></button>
    <a href="/admin/competitions" class="btn btn-outline-secondary rounded-pill px-4"><%= t('common:actions.cancel') %></a>
  </div>
</form>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
