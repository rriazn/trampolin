<%- include('../partials/header', { title: t('admin:entries.pageTitle', { name: round.name }), activePage: 'admin' }) %>
<% const baseUrl = '/admin/competitions/' + round.competition_id + '/groups/' + round.group_id + '/rounds/' + round.id %>
<div class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/admin/competitions"><%= t('admin:competitionForm.breadcrumbCompetitions') %></a></li>
        <li class="breadcrumb-item"><a href="/admin/competitions/<%= round.competition_id %>/groups"><%= round.competition_name %></a></li>
        <li class="breadcrumb-item"><a href="/admin/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds"><%= round.group_name %></a></li>
        <li class="breadcrumb-item active"><%= round.name %></li>
      </ol>
    </nav>
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-end">
      <div>
        <h1><%= t('admin:entries.heading') %></h1>
      </div>
      <div class="d-flex flex-wrap gap-3">
        <form method="POST" action="<%= baseUrl %>/attempts/bulk" class="d-flex gap-2 align-items-center">
          <div style="width:90px">
            <input type="number" name="attempt_count" class="form-control form-control-sm text-center" value="2" min="1" max="20" title="<%= t('admin:entries.attemptsPerAthlete') %>">
          </div>
          <button class="btn btn-brand" onclick="return confirm(<%= JSON.stringify(t('admin:entries.confirmCreateAll')) %>)">
            <%= t('admin:entries.createAllAttempts') %>
          </button>
        </form>
        <form method="POST" action="<%= baseUrl %>/entries/randomize" onsubmit="return confirm(<%= JSON.stringify(t('admin:entries.confirmRandomize')) %>)">
          <button type="submit" class="btn btn-outline-secondary"><%= t('admin:entries.randomize') %></button>
        </form>
        <a href="/leaderboard/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>" target="_blank" class="btn btn-outline-secondary">
          <%= t('admin:entries.leaderboard') %>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container">
  <% if (entries.length === 0) { %>
  <div class="card p-4 text-center text-muted mb-4">
    <%= t('admin:entries.noEntries') %>
  </div>
  <% } else { %>
  <div class="table-card card mb-4">
    <table class="table mb-0">
      <thead>
        <tr>
          <th style="width:100px"><%= t('admin:entries.table.startOrder') %></th>
          <th><%= t('admin:entries.table.athlete') %></th>
          <th><%= t('admin:entries.table.club') %></th>
          <th><%= t('admin:entries.table.routine') %></th>
          <th><%= t('admin:entries.table.attempts') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% entries.forEach(e => { %>
      <tr>
        <td><span class="badge bg-secondary"><%= e.start_order %></span></td>
        <td class="fw-semibold"><%= competitorName(e.sportsman_name, e.partner_name) %></td>
        <td class="text-muted"><%= competitorClub(e.club, e.partner_club) || '–' %></td>
        <td class="text-muted"><%= e.routine || '–' %></td>
        <td>
          <span class="badge <%= e.attempt_count > 0 ? 'bg-success' : 'bg-light text-muted border' %>">
            <%= t('admin:entries.attemptsCount', { count: e.attempt_count }) %>
          </span>
        </td>
        <td class="text-end">
          <form method="POST" action="<%= baseUrl %>/entries/<%= e.id %>/delete" class="d-inline"
                onsubmit="return confirm(<%= JSON.stringify(t('admin:entries.confirmRemove')) %>)">
            <button class="btn btn-sm btn-outline-danger" aria-label="<%= t('common:actions.delete') %>" title="<%= t('common:actions.delete') %>"><i class="bi bi-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <div class="card p-4">
    <h5 class="fw-bold mb-3"><%= t('admin:entries.addEntry') %></h5>
    <% if (locals.flash && locals.flash.error) { %>
    <div class="alert alert-danger mb-3"><%= locals.flash.error %></div>
    <% } %>
    <% if (available.length === 0) { %>
    <p class="text-muted mb-0"><i class="bi bi-check-circle me-1"></i><%= t('admin:entries.allRegistered') %></p>
    <% } else { %>
    <form method="POST" action="<%= baseUrl %>/entries" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label small fw-semibold text-muted text-uppercase" for="f-sportsman_id">
          <%= t('admin:entries.athlete') %><% if (prevRound) { %> <span class="fw-normal text-uppercase"><%= t('admin:entries.rankedBy', { roundName: prevRound.name }) %></span><% } %>
        </label>
        <select name="sportsman_id" id="f-sportsman_id" class="form-select" required>
          <% available.forEach(s => { %>
          <option value="<%= s.id %>"><% if (prevRound) {
            %>#<%= s.prevRank !== null ? s.prevRank : '–' %> · <% } %><%= competitorName(s.name, s.partner_name) %>
            <%= competitorClub(s.club, s.partner_club) ? ' · ' + competitorClub(s.club, s.partner_club) : '' %><%= s.routine ? ' (' + s.routine + ')' : '' %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-muted text-uppercase" for="f-start_order"><%= t('admin:entries.startOrder') %></label>
        <input type="number" name="start_order" id="f-start_order" class="form-control" value="<%= entries.length + 1 %>">
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-accent w-100"><%= t('common:actions.add') %></button>
      </div>
    </form>
    <div class="d-flex justify-content-end mt-3">
      <form method="POST" action="<%= baseUrl %>/entries/add-all" onsubmit="return confirm(<%= JSON.stringify(t('admin:entries.confirmAddAll')) %>)">
        <button type="submit" class="btn btn-brand"><%= t('admin:entries.addAll') %></button>
      </form>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
