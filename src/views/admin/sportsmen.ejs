<%- include('../partials/header', { title: t('admin:sportsmen.pageTitle', { name: competition.name }), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/admin/competitions"><%= t('admin:competitionForm.breadcrumbCompetitions') %></a></li>
        <li class="breadcrumb-item"><a href="/admin/competitions/<%= competition.id %>/groups"><%= competition.name %></a></li>
        <li class="breadcrumb-item active"><%= t('admin:sportsmen.heading') %></li>
      </ol>
    </nav>
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center">
      <div>
        <h1><%= t('admin:sportsmen.heading') %></h1>
        <p><%= competition.name %></p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#uploadForm">
          <%= t('admin:sportsmen.importExcel') %>
        </button>
        <a href="/admin/competitions/<%= competition.id %>/sportsmen/export" class="btn btn-outline-secondary">
          <%= t('admin:sportsmen.exportExcel') %>
        </a>
        <a href="/admin/competitions/<%= competition.id %>/sportsmen/new" class="btn btn-accent">
          <%= t('admin:sportsmen.addAthlete') %>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container">
  <div class="collapse mb-4" id="uploadForm">
    <div class="upload-panel">
      <h2 class="h6 fw-bold mb-1"><%= t('admin:sportsmen.importHeading') %></h2>
      <p class="text-muted small mb-3"><%- t(competition.type === 'synchro' ? 'admin:sportsmen.importHelpSynchro' : 'admin:sportsmen.importHelp') %></p>
      <form method="POST" action="/admin/competitions/<%= competition.id %>/sportsmen/upload" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap">
        <input type="file" name="file" class="form-control file-input" accept=".xlsx,.xls,.ods,.csv" required aria-label="<%= t('admin:sportsmen.importHeading') %>">
        <button type="submit" class="btn btn-brand"><%= t('admin:sportsmen.upload') %></button>
      </form>
    </div>
  </div>

  <% if (sportsmen.length === 0) { %>
  <div class="card p-4 text-center text-muted">
    <%= t('admin:sportsmen.noAthletes') %>
    <a href="/admin/competitions/<%= competition.id %>/sportsmen/new"><%= t('admin:sportsmen.addOne') %></a>.
  </div>
  <% } else { %>
  <div class="table-card card">
    <table class="table mb-0">
      <thead>
        <tr><th scope="col"><%= t('admin:sportsmen.table.athlete') %></th><th scope="col"><%= t('admin:sportsmen.table.club') %></th><th scope="col"><%= t('admin:sportsmen.table.group') %></th><th scope="col"><%= t('admin:sportsmen.table.gender') %></th><th scope="col"><%= t('admin:sportsmen.table.birthYear') %></th><th scope="col"><%= t('admin:sportsmen.table.routine') %></th><th scope="col"><span class="visually-hidden"><%= t('common:actions.column') %></span></th></tr>
      </thead>
      <tbody>
      <% sportsmen.forEach(s => { %>
      <tr>
        <td class="fw-semibold"><%= competitorName(s.name, s.partner_name) %></td>
        <td><%= competitorClub(s.club, s.partner_club) || '–' %></td>
        <td>
          <% if (s.group_name) { %>
          <span class="badge bg-light text-dark border"><%= s.group_name %></span>
          <% } else { %><span class="text-muted">–</span><% } %>
        </td>
        <td><%= [s.gender, s.partner_name ? s.partner_gender : null].filter(Boolean).join(' / ') || '–' %></td>
        <td><%= [s.birth_year, s.partner_name ? s.partner_birth_year : null].filter(Boolean).join(' / ') || '–' %></td>
        <td><%- s.routine || '<span class="text-muted">–</span>' %></td>
        <td class="text-end">
          <a href="/admin/competitions/<%= competition.id %>/sportsmen/<%= s.id %>/edit" class="btn btn-sm btn-outline-secondary me-1" aria-label="<%= t('common:actions.edit') %>" title="<%= t('common:actions.edit') %>">
            <i class="bi bi-pencil"></i>
          </a>
          <form method="POST" action="/admin/competitions/<%= competition.id %>/sportsmen/<%= s.id %>/delete" class="d-inline"
                data-confirm="<%= t('admin:sportsmen.confirmDelete', { name: competitorName(s.name, s.partner_name) }) %>">
            <button class="btn btn-sm btn-outline-danger" aria-label="<%= t('common:actions.delete') %>" title="<%= t('common:actions.delete') %>"><i class="bi bi-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
