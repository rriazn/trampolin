<%- include('../partials/header', { title: t('admin:documents.pageTitle', { name: competition.name }), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2" style="--bs-breadcrumb-divider-color:rgba(255,255,255,.5); --bs-breadcrumb-item-active-color:#fff">
        <li class="breadcrumb-item"><a href="/admin/competitions" class="text-white-50"><%= t('admin:competitionForm.breadcrumbCompetitions') %></a></li>
        <li class="breadcrumb-item active text-white"><%= competition.name %></li>
      </ol>
    </nav>
    <h1><i class="bi bi-file-earmark-text me-2"></i><%= t('admin:documents.heading') %></h1>
    <p><%= competition.name %></p>
  </div>
</div>

<div class="container">
  <p class="text-muted small mb-4">
    <i class="bi bi-info-circle me-1"></i><%= t('admin:documents.infoText') %>
  </p>

  <% const resultsReady = competition.status === 'closed'; %>
  <div class="card p-4 mb-3 document-card" id="document-results">
    <h5 class="mb-1"><i class="bi bi-file-earmark-pdf me-2"></i><%= t('admin:documents.results.title') %></h5>
    <p class="text-muted small mb-3"><%= t('admin:documents.results.description') %></p>
    <% if (!resultsReady) { %>
    <p class="mb-0"><i class="bi bi-lock me-1"></i><%= t('admin:documents.results.availableWhenClosed') %></p>
    <% } else { %>
    <form method="POST" action="/admin/competitions/<%= competition.id %>/documents/results" enctype="multipart/form-data" class="results-form">
      <label class="form-label small" for="results-template"><%= t('results:ui.templateLabel') %></label>
      <input type="file" id="results-template" name="template" accept=".typ" class="form-control form-control-sm mb-2">
      <button type="submit" class="btn btn-sm btn-brand rounded-pill me-1"><i class="bi bi-download me-1"></i><%= t('results:ui.download') %></button>
      <button type="submit" formaction="/admin/competitions/<%= competition.id %>/documents/results/preview" formtarget="_blank" class="btn btn-sm btn-outline-secondary rounded-pill preview-button" disabled><i class="bi bi-eye me-1"></i><%= t('results:ui.preview') %></button>
      <div class="small mt-2">
        <a href="/admin/competitions/<%= competition.id %>/documents/results/template"><%= t('results:ui.defaultTemplate') %></a>
      </div>
    </form>
    <% } %>
  </div>

  <% const certificatesUrl = `/admin/competitions/${competition.id}/documents/certificates`; %>
  <div class="card p-4 mb-3 document-card" id="document-certificates">
    <h5 class="mb-1"><i class="bi bi-award me-2"></i><%= t('admin:documents.certificates.title') %></h5>
    <p class="text-muted small mb-3"><%= t('admin:documents.certificates.description') %></p>
    <form method="POST" action="<%= certificatesUrl %>" enctype="multipart/form-data" class="certificates-form">
      <label class="form-label small" for="certificates-template"><%= t('certificates:ui.templateLabel') %></label>
      <input type="file" id="certificates-template" name="template" accept=".pdf" class="form-control form-control-sm mb-1">
      <div class="form-text mb-3"><%= t('certificates:ui.markersHelp', { list: markers }) %></div>

      <h6 class="small text-uppercase text-muted mb-2"><%= t('admin:documents.certificates.groupsHeading') %></h6>
      <% if (groups.length === 0) { %>
      <p class="text-muted small"><%= t('admin:documents.certificates.noGroups') %></p>
      <% } else { %>
      <ul class="list-group mb-3">
        <% groups.forEach((g) => { %>
        <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
          <span>
            <strong><%= g.name %></strong>
            <span class="small ms-2"><%= !g.ready ? (g.roundCount === 0 ? t('certificates:ui.statusNoRounds') : t('certificates:ui.statusRunning')) : g.participantCount === 0 ? t('certificates:ui.statusEmpty') : t('certificates:ui.statusReady') %></span>
            <% if (g.ready && g.participantCount > 0) { %><span class="text-muted small ms-2"><%= t('certificates:ui.participants', { count: g.participantCount }) %></span><% } %>
          </span>
          <% if (g.downloadable) { %>
          <button type="submit" formaction="/admin/competitions/<%= competition.id %>/groups/<%= g.id %>/documents/certificates" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="bi bi-download me-1"></i><%= t('certificates:ui.download') %></button>
          <% } %>
        </li>
        <% }) %>
      </ul>
      <% } %>

      <% if (groups.some((g) => g.downloadable)) { %>
      <button type="submit" class="btn btn-sm btn-brand rounded-pill me-1"><i class="bi bi-file-earmark-zip me-1"></i><%= t('certificates:ui.downloadAll') %></button>
      <% } %>
      <button type="submit" formaction="<%= certificatesUrl %>/preview" formtarget="_blank" class="btn btn-sm btn-outline-secondary rounded-pill preview-button" disabled><i class="bi bi-eye me-1"></i><%= t('certificates:ui.preview') %></button>
      <div class="small mt-2">
        <a href="<%= certificatesUrl %>/template"><%= t('certificates:ui.exampleTemplate') %></a>
      </div>
    </form>
  </div>
</div>
<script>
  // the preview only runs when a template file is chosen
  document.querySelectorAll('.results-form, .certificates-form').forEach((form) => {
    const files = form.querySelectorAll('input[type=file]');
    const preview = form.querySelector('.preview-button');
    const update = () => { preview.disabled = ![...files].some((file) => file.files.length > 0); };
    files.forEach((file) => file.addEventListener('change', update));
  });
</script>
<%- include('../partials/footer') %>
