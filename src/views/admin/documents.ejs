<%- include('../partials/header', { title: t('admin:documents.pageTitle', { name: competition.name }), activePage: 'admin' }) %>
<div class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2" style="--bs-breadcrumb-divider-color:rgba(255,255,255,.5); --bs-breadcrumb-item-active-color:#fff">
        <li class="breadcrumb-item"><a href="/admin/competitions" class="text-white-50"><%= t('admin:competitionForm.breadcrumbCompetitions') %></a></li>
        <li class="breadcrumb-item active text-white"><%= competition.name %></li>
      </ol>
    </nav>
    <h1><i class="bi bi-file-earmark-text me-2"></i><%= t('admin:documents.heading') %></h1>
    <p><%= competition.name %></p>
  </div>
</div>

<div class="container">
  <p class="text-muted small mb-4">
    <i class="bi bi-info-circle me-1"></i><%= t('admin:documents.infoText') %>
  </p>

  <% const resultsReady = competition.status === 'closed'; %>
  <div class="card p-4 mb-3 document-card" id="document-results">
    <h5 class="mb-1"><i class="bi bi-file-earmark-pdf me-2"></i><%= t('admin:documents.results.title') %></h5>
    <p class="text-muted small mb-3"><%= t('admin:documents.results.description') %></p>
    <% if (!resultsReady) { %>
    <p class="text-muted small mb-3"><i class="bi bi-lock me-1"></i><%= t('admin:documents.results.availableWhenClosed') %></p>
    <% } %>
    <form method="POST" action="/admin/competitions/<%= competition.id %>/documents/results" enctype="multipart/form-data" class="results-form">
      <label class="form-label small" for="results-template"><%= t('results:ui.templateLabel') %></label>
      <input type="file" id="results-template" name="template" accept=".typ" class="form-control form-control-sm mb-2" <%= resultsReady ? '' : 'disabled' %>>
      <button type="submit" class="btn btn-sm btn-brand rounded-pill me-1" <%= resultsReady ? '' : 'disabled' %>><i class="bi bi-download me-1"></i><%= t('results:ui.download') %></button>
      <button type="submit" formaction="/admin/competitions/<%= competition.id %>/documents/results/preview" formtarget="_blank" class="btn btn-sm btn-outline-secondary rounded-pill" disabled><i class="bi bi-eye me-1"></i><%= t('results:ui.preview') %></button>
      <div class="small mt-2">
        <a href="/admin/competitions/<%= competition.id %>/documents/results/template"><%= t('results:ui.defaultTemplate') %></a>
      </div>
    </form>
  </div>
</div>
<script>
  // the preview only runs when a template file is chosen
  document.querySelectorAll('.results-form').forEach((form) => {
    const file = form.querySelector('input[type=file]');
    const preview = form.querySelector('button[formaction]');
    file.addEventListener('change', () => { preview.disabled = file.files.length === 0; });
  });
</script>
<%- include('../partials/footer') %>
