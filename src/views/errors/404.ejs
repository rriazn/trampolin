<%- include('../partials/header', { title: t('errors:pageTitle404') }) %>
<div class="container error-page">
  <div>
    <div class="error-code">404</div>
    <div class="error-title"><i class="bi bi-signpost-2-fill me-2"></i><%= typeof message !== 'undefined' ? message : t('errors:heading404') %></div>
    <p class="error-message"><%= t('errors:message404') %></p>
    <a href="/" class="btn btn-brand rounded-pill px-4 mt-2"><i class="bi bi-house-fill me-1"></i> <%= t('errors:backToHome') %></a>
  </div>
</div>
<%- include('../partials/footer') %>
