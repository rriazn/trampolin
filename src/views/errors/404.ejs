<%- include('../partials/header', { title: 'Page Not Found' }) %>
<div class="container error-page">
  <div>
    <div class="error-code">404</div>
    <div class="error-title"><i class="bi bi-signpost-2-fill me-2"></i><%= typeof message !== 'undefined' ? message : 'Page Not Found' %></div>
    <p class="error-message">The page you're looking for doesn't exist or may have been moved.</p>
    <a href="/" class="btn btn-brand rounded-pill px-4 mt-2"><i class="bi bi-house-fill me-1"></i> Back to Home</a>
  </div>
</div>
<%- include('../partials/footer') %>
