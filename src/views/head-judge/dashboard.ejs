<%- include('../partials/header', { title: t('headJudge:dashboard.pageTitle'), activePage: 'head-judge' }) %>
<div class="page-hero">
  <div class="container">
    <h1><%= t('headJudge:dashboard.heading') %></h1>
    <p><%= t('headJudge:dashboard.subtitle') %></p>
  </div>
</div>

<div class="container">
<% if (rounds.length === 0) { %>
<div class="card p-5 text-center text-muted">
  <h2 class="h5"><%= t('headJudge:dashboard.noRoundsTitle') %></h2>
  <p class="mb-0 small"><%= t('headJudge:dashboard.noRoundsBody') %></p>
</div>
<% } else { %>
<div class="row g-3">
  <% rounds.forEach(r => { %>
  <div class="col-md-6 col-lg-4">
    <a href="/head-judge/competitions/<%= r.competition_id %>/groups/<%= r.group_id %>/rounds/<%= r.id %>" class="text-decoration-none card-link">
      <div class="card p-4 h-100">
        <div class="d-flex flex-wrap align-items-center gap-3">
          <div class="text-break">
            <div class="fw-bold"><%= r.group_name %> · <%= r.name %></div>
            <div class="text-muted small"><%= r.competition_name %></div>
          </div>
          <span class="badge ms-auto <%= r.status === 'in_progress' ? 'bg-success' : r.status === 'completed' ? 'bg-secondary' : (r.isReady ? 'bg-primary' : 'bg-warning text-dark') %>">
            <% if (r.status === 'in_progress') { %><%= t('headJudge:dashboard.statusInProgress') %>
            <% } else if (r.status === 'completed') { %><%= t('headJudge:dashboard.statusCompleted') %>
            <% } else { %><%= r.isReady ? t('headJudge:dashboard.statusReady') : t('headJudge:dashboard.statusNotStaffed') %>
            <% } %>
          </span>
        </div>
      </div>
    </a>
  </div>
  <% }) %>
</div>
<% } %>
</div>
<%- include('../partials/footer') %>
