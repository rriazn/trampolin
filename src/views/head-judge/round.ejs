<%- include('../partials/header', { title: round.name, activePage: 'head-judge' }) %>
<div class="page-hero">
  <div class="container d-flex flex-wrap gap-3 justify-content-between align-items-end">
    <div>
      <h1><%= round.name %></h1>
      <p><%= round.competition_name %> &nbsp;·&nbsp; <%= round.group_name %></p>
    </div>
    <a href="/head-judge" class="btn btn-outline-secondary btn-touch"><%= t('common:actions.back') %></a>
  </div>
</div>

<div class="container">

<% if (round.status === 'not_started') { %>
<div data-live="readiness" data-live-announce="<%= t('headJudge:round.updated') %>" data-live-key="<%= round.status %>-<%= readiness.isReady %>">
<div class="card p-4 mb-4">
  <h2 class="h5 fw-bold mb-3"><%= t('headJudge:round.readinessHeading') %></h2>
  <% if (readiness.groups.length === 0) { %>
  <p class="text-muted small mb-0"><%= t('headJudge:round.noPanelSelected') %></p>
  <% } else { %>
  <ul class="list-unstyled mb-0">
    <% readiness.groups.forEach(g => { %>
    <li class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <i class="bi <%= g.isReady ? 'bi-check-circle-fill text-success' : 'bi-exclamation-circle text-warning' %>"></i>
      <span><%= g.roleKeys.map(k => t('common:judgeRoles.' + k)).join(' & ') %></span>
      <span class="badge ms-auto <%= g.isReady ? 'bg-success' : 'bg-warning text-dark' %>"><%= t('headJudge:round.assignedCount', { assigned: g.assignedCount, required: g.required }) %></span>
    </li>
    <% }) %>
  </ul>
  <% } %>
</div>
</div>

<div class="card p-4 mb-4 text-center">
  <form method="POST" action="/head-judge/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>/start">
    <button class="btn btn-accent btn-touch px-4"><%= t('headJudge:round.startRound') %></button>
  </form>
  <% if (!readiness.isReady) { %>
  <p class="text-muted small mt-2 mb-0"><%= t('headJudge:round.notReadyNote') %></p>
  <% } %>
</div>

<% } else if (round.status === 'completed') { %>
<div data-live="completed" data-live-key="<%= round.status %>" class="card p-5 text-center text-muted">
  <h2 class="h5"><%= t('headJudge:round.completedHeading') %></h2>
  <p class="mb-3 small"><%= t('headJudge:round.completedBody') %></p>
  <div class="d-flex flex-wrap gap-2 justify-content-center">
    <a href="/leaderboard/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>" class="btn btn-accent btn-touch">
      <%= t('headJudge:round.viewLeaderboard') %>
    </a>
    <form method="POST" action="/head-judge/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>/back">
      <button class="btn btn-outline-secondary btn-touch"><%= t('headJudge:round.backToLastAttempt') %></button>
    </form>
  </div>
</div>

<% } else { %>
<div data-live="attempt" data-live-announce="<%= t('headJudge:round.updated') %>" data-live-key="<%= round.status %>-<%= attempt.attempt_id %>">
<div class="card p-4 mb-4">
  <div class="d-flex flex-wrap align-items-center gap-3">
    <span class="badge bg-secondary fs-6">#<%= attempt.start_order %></span>
    <div class="text-break">
      <div class="fw-bold fs-5">
        <%= competitorName(attempt.sportsman_name, attempt.partner_name) %>
        <% if (typeof attemptTotal !== 'undefined' && attemptTotal !== null) { %>
        <span class="text-muted">— <%= attemptTotal.toFixed(2) %><% if (!attemptIsComplete) { %><sup>*</sup><% } %></span>
        <% } %>
      </div>
      <div class="text-muted small">
        <%= competitorClub(attempt.club, attempt.partner_club) || '–' %><% if (attempt.routine) { %> &nbsp;·&nbsp; <%= attempt.routine %><% } %>
      </div>
    </div>
    <span class="badge bg-primary ms-auto"><%= t('headJudge:round.attemptNumber', { number: attempt.attempt_number }) %></span>
  </div>
  <% if (typeof attemptTotal !== 'undefined' && attemptTotal !== null && !attemptIsComplete) { %>
  <p class="text-muted small mb-0 mt-2"><sup>*</sup><%= t('headJudge:round.partialNote') %></p>
  <% } %>
</div>

<div class="card p-4 mb-4">
  <h2 class="h5 fw-bold mb-3"><%= t('headJudge:round.checklistHeading') %></h2>
  <% checklist.forEach((item, idx) => { %>
  <div class="<%= idx < checklist.length - 1 ? 'mb-3 pb-3 border-bottom' : 'mb-0' %>">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <i class="bi <%= item.isComplete ? 'bi-check-circle-fill text-success' : 'bi-hourglass-split text-warning' %>"></i>
      <span class="fw-semibold"><%= t('common:judgeRoles.' + item.judgeRoleKey) %></span>
      <span class="badge ms-auto <%= item.isComplete ? 'bg-success' : 'bg-warning text-dark' %>"><%= t('headJudge:round.submittedCount', { count: item.count, required: item.required }) %></span>
    </div>
    <% var roleJudges = typeof judgeStatus !== 'undefined' ? judgeStatus.find(function(j) { return j.key === item.judgeRoleKey; }) : null; %>
    <% if (roleJudges && roleJudges.judges.length > 0) { %>
    <div class="d-flex flex-wrap gap-2 ms-4">
      <% roleJudges.judges.forEach(j => { %>
      <div class="p-2 rounded judge-chip <%= j.isDone ? 'bg-success bg-opacity-10' : 'bg-light' %>">
        <div class="d-flex align-items-center gap-1 small <%= j.isDone ? 'text-turquoise-deep' : 'text-muted' %>">
          <i class="bi <%= j.isDone ? 'bi-check-lg' : 'bi-hourglass-split' %>"></i>
          <span class="fw-semibold"><%= j.name %></span>
        </div>
        <div class="text-muted small mt-1">
          <%= j.value !== null ? j.value.toFixed(2) : '–' %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
  <% }) %>
</div>
</div>

<% if (typeof headJudgeAssignment !== 'undefined' && headJudgeAssignment) { %>
<div class="card p-4 mb-4">
  <h2 class="h5 fw-bold mb-3" id="penalty-heading"><%= t('headJudge:round.penaltyHeading') %></h2>
  <form method="POST" action="/head-judge/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>/score" class="d-flex flex-wrap gap-2 align-items-center">
    <input type="hidden" name="attemptId" value="<%= attempt.attempt_id %>">
    <input type="number" name="score"
           value="<%= headJudgeScore !== null ? headJudgeScore : '' %>"
           min="<%= headJudgeAssignment.score_min %>" <% if (headJudgeAssignment.score_max !== null) { %>max="<%= headJudgeAssignment.score_max %>"<% } %>
           step="0.1" inputmode="decimal" class="form-control score-input" aria-labelledby="penalty-heading"
           placeholder="<%= headJudgeAssignment.score_min %>–<%= headJudgeAssignment.score_max !== null ? headJudgeAssignment.score_max : '∞' %>" required>
    <button class="btn btn-brand btn-touch"><%= t('common:actions.save') %></button>
    <% if (headJudgeScore !== null) { %>
    <span class="text-success fw-semibold small"><i class="bi bi-check-circle-fill"></i> <%= t('headJudge:round.saved') %></span>
    <% } %>
  </form>
</div>
<% } %>

<div class="card p-4 mb-4">
  <h2 class="h5 fw-bold mb-3"><%= t('headJudge:round.trickCountHeading') %></h2>
  <p class="text-muted small"><%= t('headJudge:round.trickCountHelp') %></p>
  <form method="POST" action="/head-judge/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>/attempts/<%= attempt.attempt_id %>/element-count" class="d-flex flex-wrap gap-2 align-items-end">
    <div>
      <label class="form-label small text-muted mb-1" for="f-element_count"><%= t('headJudge:round.numberOfTricks') %></label>
      <input type="number" name="element_count" id="f-element_count" value="<%= attempt.element_count %>" min="0" max="10" inputmode="numeric" class="form-control score-input">
    </div>
    <button class="btn btn-outline-secondary btn-touch"><%= t('common:actions.save') %></button>
  </form>
</div>

<div class="d-flex flex-wrap gap-2">
  <form method="POST" action="/head-judge/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>/back">
    <button class="btn btn-outline-secondary btn-touch px-4"><%= t('common:actions.back') %></button>
  </form>
  <form method="POST" action="/head-judge/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>/next">
    <button class="btn btn-accent btn-touch px-4"><%= t('headJudge:round.next') %></button>
  </form>
  <form method="POST" action="/head-judge/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>/skip"
        data-confirm="<%= t('headJudge:round.confirmSkip', { name: competitorName(attempt.sportsman_name, attempt.partner_name), number: attempt.attempt_number }) %>">
    <button class="btn btn-outline-warning btn-touch px-4"><%= t('headJudge:round.skipAthlete') %></button>
  </form>
</div>

<div class="border-top mt-5 pt-4 mb-4">
  <form method="POST" action="/head-judge/competitions/<%= round.competition_id %>/groups/<%= round.group_id %>/rounds/<%= round.id %>/complete"
        data-confirm="<%= t('headJudge:round.confirmComplete') %>">
    <button class="btn btn-outline-danger btn-touch px-4"><%= t('headJudge:round.completeRound') %></button>
  </form>
</div>
<% } %>

</div>
<script src="<%= assetUrl('/live-refresh.js') %>" defer></script>
<%- include('../partials/footer') %>
